{
  "manifest_version": 3,
  "name": "Northstar Mail",
  "version": "2.0.0",
  "description": "Ingest Outlook Web mail into Northstar while Outlook is open.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://outlook.office.com/*", "https://outlook.office365.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Northstar Mail",
    "default_popup": "popup.html"
  }
}
