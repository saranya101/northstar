generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id
  name                 String
  email                String
  emailVerified        Boolean               @default(false)
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  accounts             Account[]
  profile              Profile?
  academicProfile      UserAcademicProfile?
  studyPreference      StudyPreference?
  opportunityRadarPreference OpportunityRadarPreference?
  semesters            UserSemester[]
  moduleEnrolments     UserModuleEnrolment[]
  timetableImports     TimetableImport[]
  academicIntakes      AcademicIntake[]
  assessments          Assessment[]
  moduleWeekPreparations ModuleWeekPreparation[]
  recurringCoursework  RecurringCoursework[]
  recurringCourseworkOccurrences RecurringCourseworkOccurrence[]
  tasks                Task[]
  createdOpportunities Opportunity[]         @relation("OpportunityCreator")
  userOpportunities    UserOpportunity[]

  @@unique([email])
  @@map("user")
}

enum PreferredStudyPeriod {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String?
  timezone            String   @default("Asia/Singapore")
  onboardingStep      Int      @default(1)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model University {
  id               String                @id @default(cuid())
  name             String
  shortName        String?
  country          String
  website          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  schools          School[]
  academicTerms    AcademicTerm[]
  academicProfiles UserAcademicProfile[]
  modules          Module[]
  instructors      Instructor[]

  @@unique([name, country])
}

model School {
  id               String                @id @default(cuid())
  universityId     String
  name             String
  shortName        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  university       University            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programmes       Programme[]
  academicProfiles UserAcademicProfile[]
  modules          Module[]

  @@unique([universityId, name])
  @@index([universityId])
}

model Programme {
  id               String                @id @default(cuid())
  schoolId         String
  name             String
  degreeType       String?
  durationYears    Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicProfiles UserAcademicProfile[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AcademicTerm {
  id                String           @id @default(cuid())
  universityId      String
  academicYear      String
  name              String
  semesterNumber    Int?
  startDate         DateTime
  endDate           DateTime
  teachingStartDate DateTime?
  recessStartDate   DateTime?
  recessEndDate     DateTime?
  examStartDate     DateTime?
  examEndDate       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  university        University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  userSemesters     UserSemester[]
  moduleOfferings   ModuleOffering[]

  @@unique([universityId, academicYear, name])
  @@index([universityId])
}

model UserAcademicProfile {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  universityId           String
  schoolId               String
  programmeId            String
  admissionYear          Int
  expectedGraduationYear Int?
  currentYearOfStudy     Int        @default(1)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university             University @relation(fields: [universityId], references: [id])
  school                 School     @relation(fields: [schoolId], references: [id])
  programme              Programme  @relation(fields: [programmeId], references: [id])

  @@index([universityId])
  @@index([schoolId])
  @@index([programmeId])
}

model StudyPreference {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  preferredStudyPeriod     PreferredStudyPeriod
  typicalSessionMinutes    Int                  @default(60)
  maximumDailyStudyMinutes Int                  @default(240)
  weekStartsOn             Int                  @default(1)
  notificationsEnabled     Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OpportunityFeedRefreshCadence {
  MANUAL
  HOURLY
  EVERY_6_HOURS
  EVERY_12_HOURS
  DAILY
}

enum OpportunityDefaultSort {
  RECOMMENDED
  NEWEST
  DEADLINE
  PORTFOLIO_VALUE
}

enum OpportunityPortfolioGoal {
  LEADERSHIP
  TECHNICAL_SKILLS
  COMMUNITY_IMPACT
  BUSINESS_EXPERIENCE
  RESEARCH_EXPERIENCE
  ENTREPRENEURSHIP
  SCHOLARSHIP_EVIDENCE
  TRANSFER_APPLICATION_EVIDENCE
  NETWORKING
  RESUME_BUILDING
}

model OpportunityRadarPreference {
  id                    String                         @id @default(cuid())
  userId                String                         @unique
  feedRefreshCadence    OpportunityFeedRefreshCadence @default(EVERY_6_HOURS)
  preferredSources      String[]                       @default([])
  preferredCategories   OpportunityCategory[]          @default([])
  preferredModes        OpportunityMode[]              @default([])
  closingSoonDays       Int                            @default(7)
  defaultSort           OpportunityDefaultSort         @default(RECOMMENDED)
  hideExpired           Boolean                        @default(true)
  includeOther          Boolean                        @default(true)
  portfolioGoals        OpportunityPortfolioGoal[]     @default([])
  skillGoals            String[]                       @default([])
  lastManualRefreshAt   DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSemester {
  id                   String                @id @default(cuid())
  userId               String
  academicTermId       String
  targetSemesterGpa    Decimal?              @db.Decimal(3, 2)
  currentCumulativeGpa Decimal?              @db.Decimal(3, 2)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicTerm         AcademicTerm          @relation(fields: [academicTermId], references: [id])
  moduleEnrolments     UserModuleEnrolment[]
  timetableImports     TimetableImport[]

  @@unique([userId, academicTermId])
  @@index([userId, isActive])
  @@index([academicTermId])
}

enum ModuleSourceStatus {
  OFFICIAL_CURRENT
  OFFICIAL_HISTORICAL
  USER_ENTERED
  UNVERIFIED
}

enum ModuleEnrolmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  ARCHIVED
}

enum TimetableImportStatus {
  PROCESSING
  NEEDS_REVIEW
  CONFIRMED
  FAILED
  CANCELLED
}

enum TimetableImportSource {
  NTU_REGISTERED_COURSES_PDF
  NTU_REGISTERED_COURSES_IMAGE
  NTU_TIMETABLE_IMAGE
  PASTED_TEXT
  UNKNOWN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassSessionType {
  LECTURE
  TUTORIAL
  SEMINAR
  LABORATORY
  WORKSHOP
  PROJECT
  FIELDWORK
  OTHER
}

enum ClassSessionSource {
  IMPORTED
  MANUAL
  OFFICIAL
}

enum SessionRecurrence {
  WEEKLY
  ODD_WEEKS
  EVEN_WEEKS
  CUSTOM
}

enum CourseRegistrationStatus {
  REGISTERED
  WAITLISTED
  EXEMPTED
  UNKNOWN
}

enum SessionDeliveryMode {
  IN_PERSON
  ONLINE
  HYBRID
  TBC
  UNKNOWN
}

enum ModuleVerificationStatus {
  USER_CONFIRMED
  PUBLIC_SOURCE_MATCH
  PUBLIC_SOURCE_CONFLICT
  UNVERIFIED
}

enum InstructorRole {
  LECTURER
  TUTOR
  SEMINAR_INSTRUCTOR
  TEACHING_ASSISTANT
  COORDINATOR
  OTHER
}

enum ModuleColour {
  MINERAL
  OCEAN
  FOREST
  AMBER
  TERRACOTTA
  INDIGO
  SLATE
  ROSE
}

enum OpportunityCategory {
  INTERNSHIP
  PART_TIME_JOB
  GRADUATE_PROGRAMME
  HACKATHON
  COMPETITION
  VOLUNTEERING
  CLUB
  LEADERSHIP
  SCHOLARSHIP
  GRANT
  RESEARCH
  EXCHANGE
  SUMMER_PROGRAMME
  MENTORSHIP
  ENTREPRENEURSHIP
  WORKSHOP
  TALK
  NETWORKING
  CERTIFICATION
  AMBASSADOR
  PROJECT
  OTHER
}

enum OpportunitySourceType {
  MANUAL
  PASTED_TEXT
  PASTED_LINK
  PUBLIC_SOURCE
  EMAIL
  SCREENSHOT
  PDF
}

enum OpportunityMode {
  IN_PERSON
  ONLINE
  HYBRID
  UNKNOWN
}

enum UserOpportunityStatus {
  SAVED
  INTERESTED
  APPLYING
  APPLIED
  ACCEPTED
  REJECTED
  COMPLETED
  IGNORED
}

model Opportunity {
  id                  String                       @id @default(cuid())
  title               String
  organisation        String
  category            OpportunityCategory
  description         String?
  sourceType          OpportunitySourceType        @default(MANUAL)
  sourceName          String?
  sourceUrl           String?
  applicationUrl      String?
  publishedAt         DateTime?
  deadline            DateTime?
  startAt             DateTime?
  endAt               DateTime?
  location            String?
  mode                OpportunityMode              @default(UNKNOWN)
  commitment          String?
  eligibilityText     String?
  requirements        String?
  benefits            String?
  tags                String[]                     @default([])
  createdByUserId     String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  createdBy           User?                        @relation("OpportunityCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  userOpportunities   UserOpportunity[]
  sourceListings      OpportunitySourceListing[]
  duplicateCandidates OpportunityDuplicateReview[] @relation("DuplicateCandidate")
  probableDuplicates  OpportunityDuplicateReview[] @relation("ProbableDuplicate")

  @@index([createdByUserId])
  @@index([deadline])
  @@index([category])
  @@index([category, deadline])
}

enum OpportunitySyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model OpportunitySource {
  id               String                     @id @default(cuid())
  name             String
  slug             String                     @unique
  adapterKey       String                     @unique
  baseUrl          String
  enabled          Boolean                    @default(true)
  lastAttemptedAt  DateTime?
  lastSuccessfulAt DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  listings         OpportunitySourceListing[]
  syncRuns         OpportunitySyncRun[]
}

model OpportunitySourceListing {
  id                  String                      @id @default(cuid())
  sourceId            String
  opportunityId       String
  externalId          String?
  normalizedSourceUrl String
  contentHash         String
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  lastVerifiedAt      DateTime
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  source              OpportunitySource           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  opportunity         Opportunity                 @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  duplicateReview     OpportunityDuplicateReview?

  @@unique([sourceId, externalId])
  @@unique([sourceId, normalizedSourceUrl])
  @@index([sourceId, active])
  @@index([opportunityId])
  @@index([lastSeenAt])
}

model OpportunitySyncRun {
  id               String                @id @default(cuid())
  sourceId         String
  status           OpportunitySyncStatus @default(RUNNING)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  fetchedCount     Int                   @default(0)
  createdCount     Int                   @default(0)
  updatedCount     Int                   @default(0)
  duplicateCount   Int                   @default(0)
  invalidCount     Int                   @default(0)
  closedCount      Int                   @default(0)
  safeErrorMessage String?
  source           OpportunitySource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([status])
}

model OpportunityDuplicateReview {
  id                         String                   @id @default(cuid())
  sourceListingId            String                   @unique
  candidateOpportunityId     String
  probableMatchOpportunityId String
  fingerprint                String
  createdAt                  DateTime                 @default(now())
  resolvedAt                 DateTime?
  sourceListing              OpportunitySourceListing @relation(fields: [sourceListingId], references: [id], onDelete: Cascade)
  candidateOpportunity       Opportunity              @relation("DuplicateCandidate", fields: [candidateOpportunityId], references: [id], onDelete: Cascade)
  probableMatchOpportunity   Opportunity              @relation("ProbableDuplicate", fields: [probableMatchOpportunityId], references: [id], onDelete: Cascade)

  @@index([probableMatchOpportunityId, resolvedAt])
}

model UserOpportunity {
  id               String                @id @default(cuid())
  userId           String
  opportunityId    String
  status           UserOpportunityStatus @default(SAVED)
  personalDeadline DateTime?
  notes            String?
  savedAt          DateTime?
  appliedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity      Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([userId, status])
  @@index([opportunityId])
  @@index([personalDeadline])
}

model Module {
  id                   String                   @id @default(cuid())
  universityId         String
  schoolId             String?
  code                 String
  title                String
  description          String?
  academicUnits        Decimal?                 @db.Decimal(5, 2)
  level                String?
  gradingBasis         String?
  officialUrl          String?
  sourceStatus         ModuleSourceStatus       @default(USER_ENTERED)
  lastVerifiedAt       DateTime?
  verificationStatus   ModuleVerificationStatus @default(UNVERIFIED)
  enrichmentProvenance Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  university           University               @relation(fields: [universityId], references: [id])
  school               School?                  @relation(fields: [schoolId], references: [id])
  offerings            ModuleOffering[]

  @@unique([universityId, code])
  @@index([universityId])
  @@index([schoolId])
  @@index([code])
  @@index([title])
}

model ModuleOffering {
  id                    String                 @id @default(cuid())
  moduleId              String
  academicTermId        String
  sectionLabel          String                 @default("DEFAULT")
  gradingType           String?
  syllabusUrl           String?
  assessmentInformation String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  module                Module                 @relation(fields: [moduleId], references: [id])
  academicTerm          AcademicTerm           @relation(fields: [academicTermId], references: [id])
  instructorAssignments InstructorAssignment[]
  enrolments            UserModuleEnrolment[]

  @@unique([moduleId, academicTermId, sectionLabel])
  @@index([moduleId])
  @@index([academicTermId])
}

model Instructor {
  id                 String                 @id @default(cuid())
  universityId       String
  fullName           String
  title              String?
  schoolName         String?
  officialProfileUrl String?
  officialEmail      String?
  biography          String?
  researchInterests  String?
  sourceStatus       ModuleSourceStatus     @default(USER_ENTERED)
  lastVerifiedAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  university         University             @relation(fields: [universityId], references: [id])
  assignments        InstructorAssignment[]

  @@index([universityId])
  @@index([fullName])
  @@index([officialEmail])
}

model InstructorAssignment {
  id           String         @id @default(cuid())
  offeringId   String
  instructorId String
  role         InstructorRole @default(LECTURER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  offering     ModuleOffering @relation(fields: [offeringId], references: [id])
  instructor   Instructor     @relation(fields: [instructorId], references: [id])

  @@unique([offeringId, instructorId, role])
  @@index([offeringId])
  @@index([instructorId])
}

model UserModuleEnrolment {
  id                 String                   @id @default(cuid())
  userId             String
  userSemesterId     String
  offeringId         String
  targetGrade        String?
  targetPercentage   Decimal?                 @db.Decimal(5, 2)
  targetLabel        String?
  personalNotes      String?
  colour             ModuleColour             @default(MINERAL)
  status             ModuleEnrolmentStatus    @default(ACTIVE)
  indexNumber        String?
  courseType         String?
  registrationStatus CourseRegistrationStatus @default(UNKNOWN)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSemester       UserSemester             @relation(fields: [userSemesterId], references: [id], onDelete: Cascade)
  offering           ModuleOffering           @relation(fields: [offeringId], references: [id])
  classSessions      ClassSession[]
  academicIntakes      AcademicIntake[]
  assessments          Assessment[]
  weeklyTopics         ModuleWeeklyTopic[]
  privateFacts         UserModuleFact[]
  recurringCoursework  RecurringCoursework[]
  tasks                Task[]
  weekPreparations     ModuleWeekPreparation[]

  @@unique([userId, offeringId])
  @@index([userId])
  @@index([userSemesterId])
  @@index([status])
  @@index([offeringId])
}

enum PreparationStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NOT_REQUIRED
}

model ModuleWeekPreparation {
  id                    String              @id @default(cuid())
  userId                String
  userModuleEnrolmentId String
  teachingWeek          Int
  materialStatus        PreparationStatus   @default(NOT_STARTED)
  notesStatus           PreparationStatus   @default(NOT_STARTED)
  requiredWorkStatus    PreparationStatus   @default(NOT_STARTED)
  practiceStatus        PreparationStatus   @default(NOT_STARTED)
  questions             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userModuleEnrolment   UserModuleEnrolment @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)

  @@unique([userModuleEnrolmentId, teachingWeek])
  @@index([userId])
  @@index([userId, teachingWeek])
}

enum AcademicIntakeCategory {
  ASSESSMENT_UPDATE
  NEW_ASSESSMENT
  COURSEWORK
  DEADLINE
  CLASS_UPDATE
  TASK
  STUDY_PLAN
  GRADE_RESULT
  LECTURER_INSTRUCTION
  EXAM_INFORMATION
  ANNOUNCEMENT
  GENERAL_NOTE
}

enum AcademicIntakeStatus {
  PENDING_REVIEW
  APPLIED
  DISMISSED
  NEEDS_CLARIFICATION
  FAILED
}

enum AcademicProposalAction {
  CREATE_TASK
  UPDATE_TASK
  CREATE_ASSESSMENT
  UPDATE_ASSESSMENT
  CREATE_COURSEWORK
  UPDATE_COURSEWORK
  RECORD_GRADE
  CREATE_STUDY_PLAN
  ADD_NOTE
}

enum AcademicProposalTarget {
  TASK
  ASSESSMENT
  RECURRING_COURSEWORK
  STUDY_PLAN
  MODULE_NOTE
}

enum AcademicProposalStatus {
  PENDING
  APPLIED
  DISMISSED
  CONFLICT
}

enum AssessmentType {
  QUIZ
  MIDTERM
  FINAL_EXAMINATION
  INDIVIDUAL_ASSIGNMENT
  GROUP_ASSIGNMENT
  PRESENTATION
  CLASS_PARTICIPATION
  ATTENDANCE
  REFLECTION
  CASE_ANALYSIS
  REPORT
  PROJECT
  PRACTICAL
  LABORATORY
  ORAL_EXAMINATION
  PEER_ASSESSMENT
  OTHER
}

enum AssessmentStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  WAITING_ON_TEAMMATE
  READY_FOR_REVIEW
  SUBMITTED
  GRADED
  OVERDUE
  CANCELLED
}

enum AssessmentMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurringCourseworkType {
  LAMS
  ONLINE_ASSIGNMENT
  QUIZ
  READING
  TUTORIAL_PREPARATION
  SEMINAR_PREPARATION
  PARTICIPATION
  OTHER
}

enum RecurringCourseworkFrequency {
  WEEKLY
  FORTNIGHTLY
  CUSTOM
}

enum RecurringCourseworkStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RecurringCourseworkOccurrenceStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  MISSED
  EXCUSED
}

model AcademicIntake {
  id                    String                 @id @default(cuid())
  userId                String
  moduleEnrolmentId     String?
  rawText               String
  detectedCategory      AcademicIntakeCategory
  status                AcademicIntakeStatus   @default(PENDING_REVIEW)
  clarificationReason   String?
  interpreterKey        String                 @default("deterministic-v1")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleEnrolment       UserModuleEnrolment?   @relation(fields: [moduleEnrolmentId], references: [id], onDelete: SetNull)
  proposals             AcademicProposal[]

  @@index([userId, status, createdAt])
  @@index([moduleEnrolmentId, createdAt])
}

model AcademicProposal {
  id                    String                   @id @default(cuid())
  intakeId              String
  actionType            AcademicProposalAction
  targetType            AcademicProposalTarget
  targetId              String?
  payload               Json
  status                AcademicProposalStatus   @default(PENDING)
  conflictReason        String?
  appliedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  intake                AcademicIntake           @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId, status])
  @@index([targetType, targetId])
}

model ModuleWeeklyTopic {
  id                    String              @id @default(cuid())
  userModuleEnrolmentId String
  weekNumber            Int
  topic                 String?
  reading               String?
  activity              String?
  importantDate         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userModuleEnrolment   UserModuleEnrolment @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)

  @@unique([userModuleEnrolmentId, weekNumber])
  @@index([userModuleEnrolmentId])
}

model UserModuleFact {
  id                    String              @id @default(cuid())
  userModuleEnrolmentId String
  fieldName             String
  value                 String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userModuleEnrolment   UserModuleEnrolment @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)

  @@unique([userModuleEnrolmentId, fieldName])
  @@index([userModuleEnrolmentId])
}

model Assessment {
  id                    String           @id @default(cuid())
  userId                String
  userModuleEnrolmentId String
  name                  String
  normalizedName        String
  type                  AssessmentType
  weight                Decimal?         @db.Decimal(5, 2)
  officialDeadline      DateTime?
  internalDeadline      DateTime?
  eventDate             DateTime?
  eventEndDate          DateTime?
  submissionPlatform    String?
  submissionUrl         String?
  instructions          String?
  examFormat            String?
  estimatedEffortMinutes Int?
  actualEffortMinutes   Int?
  groupAssessment       Boolean?
  status                AssessmentStatus @default(NOT_STARTED)
  score                 Decimal?         @db.Decimal(10, 2)
  maximumScore          Decimal?         @db.Decimal(10, 2)
  percentageScore       Decimal?         @db.Decimal(7, 4)
  weightedScore         Decimal?         @db.Decimal(7, 4)
  feedback              String?
  reflection            String?
  submittedAt           DateTime?
  gradedAt              DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userModuleEnrolment   UserModuleEnrolment @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)
  deliverables          AssessmentDeliverable[]
  milestones            AssessmentMilestone[]
  recurringCoursework   RecurringCoursework[]
  tasks                 Task[]

  @@index([userId, userModuleEnrolmentId])
  @@index([userModuleEnrolmentId, officialDeadline])
}

model RecurringCoursework {
  id                    String                       @id @default(cuid())
  userId                String
  userModuleEnrolmentId String
  assessmentId          String?
  title                 String
  type                  RecurringCourseworkType
  description           String?
  frequency             RecurringCourseworkFrequency
  totalExpected         Int
  firstTeachingWeek     Int?
  lastTeachingWeek      Int?
  recessWeeks           Int[]                        @default([])
  includeRecessWeeks    Boolean                      @default(false)
  graded                Boolean                      @default(false)
  totalAssessmentWeight Decimal?                     @db.Decimal(5, 2)
  completeBeforeClass   Boolean                      @default(false)
  timingNote            String?
  status                RecurringCourseworkStatus    @default(ACTIVE)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userModuleEnrolment   UserModuleEnrolment          @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)
  assessment            Assessment?                  @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  occurrences           RecurringCourseworkOccurrence[]
  tasks                 Task[]

  @@index([userId, userModuleEnrolmentId, status])
  @@index([assessmentId])
}

model RecurringCourseworkOccurrence {
  id                       String                              @id @default(cuid())
  userId                   String
  recurringCourseworkId    String
  sequenceNumber           Int
  teachingWeek             Int?
  officialDueAt            DateTime?
  timingNote               String?
  status                   RecurringCourseworkOccurrenceStatus @default(NOT_STARTED)
  workCompleted            Boolean                             @default(false)
  finalConfirmationClicked Boolean                             @default(false)
  gradeCentreChecked       Boolean                             @default(false)
  markCaptured             Boolean                             @default(false)
  startedAt                DateTime?
  submittedAt              DateTime?
  verifiedAt               DateTime?
  score                    Decimal?                            @db.Decimal(10, 2)
  maximumScore             Decimal?                            @db.Decimal(10, 2)
  submissionReference      String?
  privateNotes             String?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt
  user                     User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringCoursework      RecurringCoursework                 @relation(fields: [recurringCourseworkId], references: [id], onDelete: Cascade)
  tasks                    Task[]

  @@unique([recurringCourseworkId, sequenceNumber])
  @@index([userId, status])
  @@index([officialDueAt])
}

model AssessmentDeliverable {
  id           String   @id @default(cuid())
  assessmentId String
  title        String
  description  String?
  required     Boolean  @default(true)
  completed    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, sortOrder])
}

model AssessmentMilestone {
  id                     String                    @id @default(cuid())
  assessmentId           String
  title                  String
  dueDate                DateTime?
  status                 AssessmentMilestoneStatus @default(NOT_STARTED)
  estimatedEffortMinutes Int?
  notes                  String?
  sortOrder              Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  assessment             Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  tasks                  Task[]

  @@index([assessmentId, sortOrder])
  @@index([dueDate])
}

enum TaskType {
  STUDY
  REVISION
  ASSIGNMENT
  READING
  PRACTICE
  ADMIN
  GROUP_WORK
  OTHER
}

enum TaskStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id                              String                        @id @default(cuid())
  userId                          String
  moduleEnrolmentId               String?
  assessmentId                    String?
  recurringCourseworkId           String?
  recurringCourseworkOccurrenceId String?
  assessmentMilestoneId           String?
  parentTaskId                    String?
  title                           String
  description                     String?
  type                            TaskType                      @default(STUDY)
  status                          TaskStatus                    @default(BACKLOG)
  priority                        TaskPriority                  @default(MEDIUM)
  dueAt                           DateTime?
  timingNote                      String?
  estimatedMinutes                Int?
  actualMinutes                   Int?
  sortOrder                       Int                           @default(0)
  startedAt                       DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  user                            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleEnrolment                 UserModuleEnrolment?          @relation(fields: [moduleEnrolmentId], references: [id], onDelete: SetNull)
  assessment                      Assessment?                   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  recurringCoursework             RecurringCoursework?          @relation(fields: [recurringCourseworkId], references: [id], onDelete: SetNull)
  recurringCourseworkOccurrence   RecurringCourseworkOccurrence? @relation(fields: [recurringCourseworkOccurrenceId], references: [id], onDelete: SetNull)
  assessmentMilestone             AssessmentMilestone?          @relation(fields: [assessmentMilestoneId], references: [id], onDelete: SetNull)
  parentTask                      Task?                          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks                        Task[]                         @relation("TaskSubtasks")

  @@unique([userId, recurringCourseworkOccurrenceId])
  @@unique([userId, assessmentMilestoneId])
  @@index([userId, status, dueAt])
  @@index([moduleEnrolmentId])
  @@index([assessmentId])
  @@index([recurringCourseworkId])
  @@index([parentTaskId, sortOrder])
}

model TimetableImport {
  id                   String                @id @default(cuid())
  userId               String
  userSemesterId       String
  source               TimetableImportSource
  status               TimetableImportStatus @default(NEEDS_REVIEW)
  parserVersion        String
  candidatePayload     Json
  warnings             Json?
  detectedModuleCount  Int                   @default(0)
  detectedSessionCount Int                   @default(0)
  confirmedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSemester         UserSemester          @relation(fields: [userSemesterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userSemesterId])
  @@index([status])
  @@index([createdAt])
}

model ClassSession {
  id                    String              @id @default(cuid())
  userModuleEnrolmentId String
  classType             ClassSessionType
  groupLabel            String              @default("DEFAULT")
  dayOfWeek             DayOfWeek
  startMinutes          Int
  endMinutes            Int
  venue                 String?
  recurrence            SessionRecurrence   @default(WEEKLY)
  weekNumbers           Int[]               @default([])
  source                ClassSessionSource  @default(MANUAL)
  deliveryMode          SessionDeliveryMode @default(UNKNOWN)
  confidence            Decimal?            @db.Decimal(3, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  userModuleEnrolment   UserModuleEnrolment @relation(fields: [userModuleEnrolmentId], references: [id], onDelete: Cascade)

  @@unique([userModuleEnrolmentId, classType, groupLabel, dayOfWeek, startMinutes, endMinutes])
  @@index([userModuleEnrolmentId])
  @@index([dayOfWeek])
  @@index([startMinutes])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
