# Pooled Neon connection used by the Northstar application at runtime.
DATABASE_URL=""

# Direct Neon connection used only by Prisma CLI commands and migrations.
DIRECT_URL=""

# High-entropy Better Auth secret. Never commit a populated value.
BETTER_AUTH_SECRET=""

# Must match the application origin. Production must use its HTTPS origin.
BETTER_AUTH_URL="http://localhost:3000"
